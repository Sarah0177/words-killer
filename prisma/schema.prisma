generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

model Words {
  id          Int     @id @default(autoincrement())
  content     String @unique
  isKilled    Boolean @default(false)
  addAt       DateTime @default(now())
  lastKillAt  DateTime?
  killTimes   Int? @default(0)
  degree      String? @default("easy")
  needKillTimes Int? @default(4)
}

model task {
  id             Int @id @default(autoincrement())
  date           String @unique
  plannedWords   String
  completedWords String
  isCompleted  Boolean @default(false)
  plannedNumber  Int @default(3)
  completedNumber Int @default(0)
  isMadeUp     Boolean @default(false)
  hasSetTask   Boolean @default(false)
}
